# Built binary and build artifacts (produced by `make`; `make clean` removes
# them). Nothing built belongs in version control.
/sdrprobe
/build/

# Object files and other compiler output.
*.o
*.obj

# Patch/merge leftovers.
*.orig
*.rej

# Editor/OS noise.
*.swp
*~
*.log
/sdrprobe.log
.DS_Store

# Raw-I/Q recordings from the Record button (user captures, not fixtures).
/captures/

# External capture corpus. Keep local copies here for checks and diagnostics;
# the recordings and sidecars are distributed separately from Git.
/testfiles/

# Band surveys. Measurements of one operator's location with one antenna, the
# same kind of thing as captures/ and kept for the same reason: they are how a
# later sweep is compared with an earlier one, and they are nobody else's
# baseline. docs/band-surveys.md documents the format; the data stays here.
/surveys/
__pycache__/

# Local AI-tool wiring and editor config: machine-specific, not this
# project's business, and not something every clone should inherit.
/.claude/CLAUDE.md
/.claude/settings.json
/.codegraph/
/.codex/
/.mcp.json
/.vscode/
/opencode.jsonc
